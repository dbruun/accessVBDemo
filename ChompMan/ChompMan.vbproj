<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ChompMan</RootNamespace>
    <AssemblyName>ChompMan</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Platforms>AnyCPU</Platforms>
    <StartupObject>ChompMan.Program</StartupObject>
    <!-- Allows cross-compilation targeting Windows on non-Windows hosts -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- OleDb is built into .NET Framework — no package needed -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChompMan.Core\ChompMan.Core.vbproj" />
  </ItemGroup>

  <!-- Exclude files that live in ChompMan.Core to avoid duplicate type definitions -->
  <ItemGroup>
    <Compile Remove="GameEngine\**" />
    <Compile Remove="DataAccess\Models.vb" />
    <Compile Remove="DataAccess\IScoreRepository.vb" />
    <Compile Remove="DataAccess\ILevelRepository.vb" />
  </ItemGroup>

</Project>
